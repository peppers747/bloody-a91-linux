# Regras udev para dispositivos A4Tech Bloody (Vendor ID: 09da)
# MODE="0666" garante acesso imediato para qualquer usuário sem precisar reiniciar ou fazer logout

# 1. Permissão total para criação de mouse virtual via uinput
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput", MODE="0666", GROUP="input"

# 2. Acesso USB direto para controle de LEDs
SUBSYSTEMS=="usb", ATTRS{idVendor}=="09da", TAG+="uaccess", MODE="0666", GROUP="input"

# 3. Acesso aos nós HID e Eventos do mouse Bloody
KERNEL=="hidraw*", ATTRS{idVendor}=="09da", TAG+="uaccess", MODE="0666", GROUP="input"
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="09da", TAG+="uaccess", MODE="0666", GROUP="input"
