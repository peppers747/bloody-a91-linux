# Regras udev do BloodyLinux para mouses A4Tech Bloody (Vendor ID 09da).
#
# O nome começa com 70- de propósito: TAG+="uaccess" precisa ser aplicado antes de
# 73-seat-late.rules (systemd), que é quem concede o acesso ao usuário da sessão.
#
# TAG+="uaccess" dá acesso ao usuário logado na sessão local (sem sudo e sem logout).
# GROUP="input" mantém o acesso também para membros do grupo input.
# MODE 0660 (e não 0666) evita que qualquer usuário/serviço do sistema injete
# eventos de teclado/mouse pelo uinput.

# 1. Criação do mouse virtual via uinput
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess", GROUP="input", MODE="0660"

# 2. Acesso USB direto (controle de LEDs)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09da", TAG+="uaccess", GROUP="input", MODE="0660"

# 3. Nós HID e de eventos do mouse Bloody
KERNEL=="hidraw*", ATTRS{idVendor}=="09da", TAG+="uaccess", GROUP="input", MODE="0660"
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="09da", TAG+="uaccess", GROUP="input", MODE="0660"
